# Sensitive environment variables for {{ app_name }}
# This file is loaded by systemd EnvironmentFile directive
# Mode: 0600 (owner read/write only)
# DO NOT commit actual values to version control

# PII/document encryption key (AES-256, 32 bytes Base64 encoded)
# REQUIRED in the production profile. site.yml and deploy.yml pre_tasks refuse
# to continue when this is missing or malformed.
# Generate with: openssl rand -base64 32
{% if document_encryption_key is defined and document_encryption_key | length > 0 %}
APP_ENCRYPTION_KEY={{ document_encryption_key }}
{% endif %}

# Remember-me token signing key (32 bytes Base64 encoded)
# REQUIRED in the production profile. site.yml and deploy.yml pre_tasks refuse
# to continue when this is missing, malformed, or the development default.
# Generate with: openssl rand -base64 32
{% if app_remember_me_key is defined and app_remember_me_key | length > 0 %}
APP_REMEMBER_ME_KEY={{ app_remember_me_key }}
{% endif %}
